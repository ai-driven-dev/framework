{
  "closesWhen": {
    "classification": "every file under src and tests is renamed or moved to the folder of its kind, or is listed outside the catalog on purpose",
    "imports": "the file stops importing that target, or the target moves to a kind the file may import",
    "mirror": "a test of the required level exists at the mirror path of the source",
    "shape": "the class takes the shape of its kind: one class named after its file, a public execute, at most five dependencies, the tool catalog at construction",
    "thrown": "the class is thrown where its code path is, or deleted",
    "instructs": "the message names a command the CLI declares",
    "composition": "composition holds one module per context, plus container, shared and orchestration/",
    "ports": "the method gets a caller in src, or leaves the port",
    "sections": "the method gets a caller in src, or leaves the section",
    "answers": "the plugin answers by a method and its data is a # field",
    "repository": "the test reaches the repository through tests/helpers/repository-root.ts",
    "translate": "translate names no other host's manifest path",
    "size": "the test file is split under 800 lines",
    "limits": "the file stops breaking that size limit and leaves its exclusion in biome.json",
    "toolNames": "the file reads the tool from its profile instead of naming it",
    "toolSites": "the registration moves into the profile or the composition list is rewritten",
    "toolOwn": "the file stops naming its own tool",
    "toolIdentifiers": "the file stops carrying a tool name in an identifier",
    "exemptProcessExit": "the file stops exiting the process and leaves its exclusion in biome.json",
    "exemptGithubUrl": "the file stops writing the GitHub API URL, or the adapter is the only one that ever did",
    "exemptDefaultExport": "no declaration file needs a default export",
    "exemptProfileImport": "the folder stops importing a whole profile",
    "exemptProfileList": "the folder stops listing profiles",
    "profile": "the reader names the sections of the tool it reads in its own ports, never the whole profile"
  },
