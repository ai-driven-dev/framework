{
  "claude": {
    "kind": "ai",
    "displayName": "Claude Code",
    "directory": ".claude/",
    "toolSuffix": ".claude.md",
    "signalDir": ".claude/commands",
    "sectionKeys": [
      "agents",
      "commands",
      "mcp",
      "plugins",
      "rules",
      "skills"
