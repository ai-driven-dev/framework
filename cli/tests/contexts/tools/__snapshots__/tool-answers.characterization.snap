      "hooksTrustNotice": null,
      "acceptsMcp": true,
      "mcpRelativePath": ".mcp.json",
      "hooksRelativePath": "hooks/hooks.json",
      "projectHooksRelativePath": null,
      "projectHooksFormat": null,
      "hookScript": {
        "script": "console.log(1);",
        "hooksJson": "{\"hooks\":{\"PreToolUse\":[{\"matcher\":\"Bash\",\"hooks\":[{\"type\":\"command\",\"command\":\"node ${CLAUDE_PLUGIN_ROOT}/hooks/run.js\"}]}]}}"
      },
      "flatNamespacePrefix": null,
      "flatSkillLayout": "nested",
      "flatHooksDir": null,
      "flatHooksLoaderEntry": null,
      "flatHooksBridge": null,
      "translationMode": "marketplace",
      "nativeActivation": {
        "binary": "claude",
        "scopeArgs": {
          "project": [
            "--scope",
            "local"
          ],
          "user": [
            "--scope",
            "user"
          ]
        },
        "userRemoveArgs": [],
