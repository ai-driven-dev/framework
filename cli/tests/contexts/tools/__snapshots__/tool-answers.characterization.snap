        ".claude-plugin/plugin.json"
      ],
      "marketplace": [
        ".claude-plugin/marketplace.json"
      ]
    },
    "rewriteContent": "See .claude/skills/x and CLAUDE.md for the Claude flow.",
    "rulesInstalledLocation": {
      "directory": ".claude/rules/",
      "extension": ".md"
    },
    "plugins": {
      "mode": "native",
      "installScope": "project",
      "hooksDestination": "plugin",
      "pluginsDir": ".claude/plugins/",
      "resolvePluginsBaseDir": "/fake/project",
