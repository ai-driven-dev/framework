exports[`the data each registered profile declares > antigravity 1`] = `
{
  "builds": [
    "flat",
    "marketplace",
  ],
  "configFiles": {},
  "directory": ".agents/",
  "displayName": "Antigravity CLI",
  "distribution": {
    "manifest": [
      "plugin.json",
    ],
    "marketplace": [
      ".antigravity-plugin/marketplace.json",
    ],
  },
  "frontmatter": {
    "agents": {
      "description": "Review code",
      "model": "inherit",
      "name": "reviewer",
      "tools": "["view_file"]",
    },
    "commands": null,
    "rules": {
      "a description alone": {
        "description": "d",
        "trigger": "always_on",
      },
      "a description that opts out of always-apply": {
        "description": "d",
        "trigger": "always_on",
      },
      "a paths list": {
        "globs": "a, b",
        "trigger": "glob",
      },
      "an always-apply rule": {
        "description": "d",
        "trigger": "always_on",
      },
      "an empty paths list": {
        "trigger": "always_on",
      },
      "an opt-out with no description": {
        "trigger": "always_on",
      },
      "globs that apply on request": {
        "description": "d",
        "globs": "a",
        "trigger": "glob",
      },
      "paths beside a description": {
        "description": "d",
        "globs": "a",
        "trigger": "glob",
      },
    },
  },
  "hooksRootToken": null,
  "installs": {
    "agents": {
      ".gitkeep": ".agents/agents/.gitkeep",
      "helper.txt": ".agents/agents/helper.txt",
