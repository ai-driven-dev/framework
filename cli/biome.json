{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "suspicious": {
        "noImportCycles": "error",
        "noTsIgnore": "error"
      },
      "correctness": {
        "noUnresolvedImports": "error"
      },
      "style": {
        "noExportedImports": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.e2e-build",
      "!**/node_modules",
      "!**/example",
      "!**/temp",
      "!**/coverage",
      "!demo",
      "!.aidd",
      "!.claude",
      "!.cursor",
      "!.opencode",
      "!.specstory",
      "!.vscode",
      "!setup-test",
      "!tmp-test",
      "!tmp",
      "!.stryker-tmp",
      "!reports",
      "!**/fixtures"
    ]
  },
  "overrides": [
    {
      "includes": ["src/kernel/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/domain/**",
                      "**/application/**",
                      "**/infrastructure/**",
                      "**/presentation/**",
                      "**/runtime/**",
                      "**/shared/**"
                    ],
                    "message": "kernel must not import any context or shared: it is the old home of the shared vocabulary, not a consumer of one"
                  },
                  {
                    "group": ["**/composition/**"],
                    "message": "only the composition root imports the composition, see context-graph.arch.test.ts"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/ports/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/contexts/**",
                      "**/presentation/**",
                      "**/runtime/**",
                      "**/infrastructure/**"
                    ],
                    "message": "shared/ports declares an interface and imports no context, no layer above it and no adapter: see 0-contexts.md"
                  },
                  {
                    "group": ["**/composition/**"],
                    "message": "only the composition root imports the composition, see context-graph.arch.test.ts"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/infrastructure/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/contexts/**", "**/presentation/**", "**/runtime/**"],
                    "message": "shared/infrastructure implements a port and imports no context and nothing above it: a context is satisfied by shape, not by import"
                  },
                  {
                    "group": ["**/composition/**"],
                    "message": "only the composition root imports the composition, see context-graph.arch.test.ts"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/presentation/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/shared/infrastructure/**"],
                    "message": "only the composition root imports shared/infrastructure: take the port from shared/ports"
                  },
                  {
                    "group": ["**/composition/**"],
                    "message": "only the composition root imports the composition, see context-graph.arch.test.ts"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/runtime/**/*.ts", "!src/runtime/wiring/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/shared/infrastructure/**"],
                    "message": "only the composition root imports shared/infrastructure: take the port from shared/ports"
