{
  "kind": "shadow",
  "unit": "file",
  "scope": ["**/*-shadow-report.md"],
  "rules": {
    "SHADOW-01": { "op": "template", "template": "../assets/report-template.md", "optional": ["{{category}}", "Closed"], "values": { "status": ["clean", "open"] }, "fix": "follow report-template.md" },
    "SHADOW-02": { "op": "custom", "check": "categories" },
    "SHADOW-03": { "op": "custom", "check": "gaps" },
    "SHADOW-04": { "op": "custom", "check": "evidence" },
    "SHADOW-05": { "op": "custom", "check": "duplicates" },
    "SHADOW-06": { "op": "custom", "check": "counts" }
  }
}
