{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/artifacts.cjs start",
            "timeout": 5,
            "statusMessage": "AIDD Refine: note turn start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash|Shell|bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/artifacts.cjs mark",
            "timeout": 5,
            "statusMessage": "AIDD Refine: check written artifacts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/artifacts.cjs check",
            "timeout": 5,
            "statusMessage": "AIDD Refine: check written artifacts"
          }
        ]
      }
    ]
  }
}
