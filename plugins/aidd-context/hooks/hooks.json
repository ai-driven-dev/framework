{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/memory.cjs load",
            "timeout": 5,
            "statusMessage": "AIDD Context: refresh project memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/memory.cjs guard",
            "timeout": 5,
            "statusMessage": "AIDD Context: check memory changes"
          }
        ]
      }
    ]
  }
}
