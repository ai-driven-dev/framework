{
  "kind": "command",
  "unit": "file",
  "scope": [
    ".claude/commands/*.md",
    ".github/prompts/*.prompt.md",
    ".opencode/commands/*.md",
    ".kilo/commands/*.md"
  ],
  "shell": false,
  "rules": {
    "COMMAND-01": {
      "op": "template",
      "in": "*.md",
      "template": "../assets/command-template.md",
      "why": "one shape per command",
      "fix": "follow command-template.md",
      "additionalFrontmatterIn": [
        "**/.claude/commands/*.md",
        "**/.github/prompts/*.prompt.md",
        "**/.opencode/commands/*.md",
        "**/.kilo/commands/*.md"
      ],
      "optional": [
        "argument-hint",
        "model",
        "agent",
        "allowed-tools",
        "disable-model-invocation"
      ]
    }
  }
}
