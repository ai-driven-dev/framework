{
  "version": 1,
  "kind": "command",
  "unit": "file",
  "rules": {
    "COMMAND-01": {
      "op": "template",
      "in": "*.md",
      "template": "../assets/command-template.md",
      "why": "one shape per command",
      "fix": "follow command-template.md",
      "optional": [
        "argument-hint",
        "model",
        "agent",
        "allowed-tools",
        "disable-model-invocation"
      ]
    }
  }
}
