{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.cjs",
            "timeout": 10,
            "statusMessage": "AIDD Telemetry: carry Claude session task"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/catch-up.cjs",
            "async": true,
            "timeout": 120,
            "statusMessage": "AIDD Telemetry: update measurement ledger"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/prompt-gate.cjs",
            "timeout": 30,
            "statusMessage": "AIDD Telemetry: check task declaration"
          }
        ]
      }
    ]
  }
}
