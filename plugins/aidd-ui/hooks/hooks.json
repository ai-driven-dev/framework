{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/aidd-ui.cjs hook",
            "timeout": 5,
            "statusMessage": "AIDD UI: note design system errors"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Delete|Bash|Shell|bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/aidd-ui.cjs hook",
            "timeout": 5,
            "statusMessage": "AIDD UI: check design system"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/aidd-ui.cjs hook",
            "timeout": 5,
            "statusMessage": "AIDD UI: check design system before finishing"
          }
        ]
      }
    ]
  }
}
