{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/ui-hook.cjs",
            "timeout": 30,
            "statusMessage": "AIDD UI: check design system"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/ui-hook.cjs",
            "timeout": 30,
            "statusMessage": "AIDD UI: check changed files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/ui-hook.cjs",
            "timeout": 30,
            "statusMessage": "AIDD UI: verify design system before finishing"
          }
        ]
      }
    ]
  }
}
