{
  "version": 1,
  "kind": "plan",
  "unit": "folder",
  "marker": "plan.md",
  "rules": {
    "PLAN-01": {
      "op": "template",
      "in": "plan.md",
      "template": "../assets/plan-template.md",
      "optional": [
        "Rules",
        "Decisions"
      ],
      "why": "the implementer reads every plan the same way",
      "fix": "follow plan-template.md"
    },
    "PLAN-02": {
      "op": "template",
      "in": "phase-*.md",
      "template": "../assets/phase-template.md",
      "optional": [
        "Wireframe"
      ],
      "why": "the implementer reads every phase the same way",
      "fix": "follow phase-template.md"
    },
    "PLAN-03": {
      "op": "custom",
      "in": "plan.md",
      "check": "phases",
      "why": "the phase table is the order the implementer runs",
      "fix": "fix the phase table"
    },
    "PLAN-04": {
      "op": "custom",
      "in": "plan.md",
      "check": "sources",
      "why": "a source without a URL cannot be re-read",
      "fix": "give each source its URL"
    },
    "PLAN-05": {
      "op": "custom",
      "in": "plan.md",
      "check": "projection",
      "why": "a phase that modifies a missing file cannot run",
      "fix": "fix the projection"
    },
    "PLAN-06": {
      "op": "custom",
      "in": "phase-*.md",
      "check": "wireframe",
      "why": "an unnumbered wireframe cannot be referred to",
      "fix": "number the wireframe regions"
    },
    "PLAN-07": {
      "op": "custom",
      "in": "phase-*.md",
      "check": "tasks",
      "why": "each criterion must point at a task",
      "fix": "fix the task numbers"
    }
  }
}
