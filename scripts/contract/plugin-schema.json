{
  "type": "object",
  "required": ["name", "version", "description", "skills"],
  "properties": {
    "name": { "type": "string", "pattern": "^aidd-[a-z]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1 },
    "skills": { "type": "array", "items": { "type": "string", "pattern": "^\\./skills/\\d\\d-[a-z-]+$" } }
  }
}
